# Server Port (Local development)
PORT=3000

# VAPID Keys for Web Push Notifications
# Generate with: npm run generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@gtaclock.com

# Optional: Vercel KV / Upstash Redis (for persisting push subscriptions across deploys)
# If you add Vercel KV via the Vercel Storage dashboard, these are injected automatically!
KV_REST_API_URL=
KV_REST_API_TOKEN=
