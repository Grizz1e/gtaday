# Server Port (Local development)
PORT=3000

# Resend API Key (https://resend.com)
# When set, subscribers are automatically added to Resend Contacts permanently
# and sent a launch confirmation email. This persists forever across all Vercel deploys!
RESEND_API_KEY=
RESEND_FROM_EMAIL=GTA Clock <onboarding@resend.dev>

# Optional: Specific Resend Audience ID (found under Resend -> Audiences)
# If left empty, contacts are added to your default general audience.
RESEND_AUDIENCE_ID=

# Optional: Vercel KV / Upstash Redis
# If you add Vercel KV via the Vercel Storage dashboard, these are injected automatically!
KV_REST_API_URL=
KV_REST_API_TOKEN=
