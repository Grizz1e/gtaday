# Server Port (Local development)
PORT=3000

# VAPID Keys for Web Push Notifications
# Generate with: npm run generate-vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@gtaclock.com

# Optional: Vercel KV / Upstash Redis (for persisting push subscriptions across deploys)
# If you add Vercel KV via the Vercel Storage dashboard, these are injected automatically!
# REQUIRED on Render/Vercel — local JSON does not survive deploys/restarts.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (alias names also accepted)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: protect /api/cron/dispatch with a shared secret.
# Call it as: GET /api/cron/dispatch with header "Authorization: Bearer <secret>"
# Vercel Cron sends header "x-vercel-cron: 1" and is allowed through.
CRON_SECRET=

# In-process per-minute scheduler (Render / local / VPS). Set to 0 on Vercel serverless.
SCHEDULER_ENABLED=1
SCHEDULER_INTERVAL_MS=60000
